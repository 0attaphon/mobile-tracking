    "buffer": "^6.0.3",
    "expo": "~52.0.46",
    "expo-application": "^5.9.1",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.20",
    "expo-image-manipulator": "~13.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.3",
