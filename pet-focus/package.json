{
  "name": "FOCUS GROUP",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "bash scripts/start-dev.sh",
    "start:lan": "expo start --dev-client --lan",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:android": "adb reverse tcp:8081 tcp:8081 && expo start --dev-client --localhost",
    "android": "adb reverse tcp:8081 tcp:8081 && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run"
  },
  "dependencies": {
